		{"height":180,"id":"6fba69759ebe90f4052e135c354bd980f7749d5507fe66c28097b8aeca688ff8","text":"# Released cognitive views\n\nStatic, safe-public, generated, nonauthoritative metadata. This is not live operational state.","type":"text","width":720,"x":0,"y":0},
		{"height":160,"id":"1451c4311c47e1c7d0b3c7b0c5fc2cdfa23dd6004795ee8f671f59ff4ca56061","text":"Agent scores and health are unavailable. Released agent-related records are not scorecards.","type":"text","width":340,"x":0,"y":220},
		{"height":160,"id":"9ecb9747744205f5a985c4d1918e5b3635a6369529a830235c32434d59cf56de","text":"Token and value accounting are unavailable. Unknown does not imply zero.","type":"text","width":340,"x":380,"y":220},
		{"height":160,"id":"32017b39f455f868d81793e765370d9559004d8d0e9a103dc4f5c38dfff36d34","text":"Loop state is unavailable because the released cognitive source exposes no loop signal.","type":"text","width":340,"x":0,"y":420},
