{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive-mind-os.local/schemas/brain-kernel-charter.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "mission_id", "created_at", "objective", "acceptance_specs", "repository_root", "base_commit", "target_branch", "policy_fingerprint", "role_registry_fingerprint", "model_route_fingerprint", "budget", "external_grants", "protected_branches", "human_gates", "status"],
  "properties": {
    "schema_version": {"const": 1}, "mission_id": {"type": "string", "pattern": "^MISSION-[A-Za-z0-9][A-Za-z0-9._-]*$"}, "created_at": {"type": "string", "format": "date-time"}, "objective": {"type": "string", "minLength": 1}, "acceptance_specs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "repository_root": {"type": "string", "minLength": 1}, "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "target_branch": {"type": "string", "minLength": 1}, "policy_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "role_registry_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "model_route_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "budget": {"type": "object", "additionalProperties": false, "required": ["max_wall_seconds", "max_model_calls", "max_input_tokens", "max_output_tokens", "max_cost_microunits", "max_tool_calls", "max_work_items", "max_depth"], "properties": {"max_wall_seconds": {"type":"integer","minimum":0}, "max_model_calls": {"type":"integer","minimum":0}, "max_input_tokens": {"type":"integer","minimum":0}, "max_output_tokens": {"type":"integer","minimum":0}, "max_cost_microunits": {"type":"integer","minimum":0}, "max_tool_calls": {"type":"integer","minimum":0}, "max_work_items": {"type":"integer","minimum":0}, "max_depth": {"type":"integer","minimum":0}}}, "external_grants": {"type":"array","items":{"type":"string"}}, "protected_branches": {"type":"array","items":{"type":"string"}}, "human_gates": {"type":"array","items":{"type":"string"}}, "status": {"enum": ["CREATED", "PLANNING", "READY", "RUNNING", "VERIFYING", "INTEGRATING", "COMPLETED", "WAITING_HUMAN", "PAUSED", "FAILED", "CANCELLED", "ROLLING_BACK"]}
  }
}
