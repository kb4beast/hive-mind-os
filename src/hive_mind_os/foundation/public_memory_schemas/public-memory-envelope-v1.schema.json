{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive-mind-os.invalid/contracts/public-memory-envelope/v1",
  "type": "object",
  "required": ["schema_version", "release_policy", "record_id", "record_type", "source_schema", "tenant_id", "repository_id", "source_digest", "source_previous_digest", "actor_id", "observed_at", "recorded_at", "status", "sensitivity", "public_release_decision_id", "public_release_decided_by", "public_release_subject_digest", "payload"],
  "properties": {
    "schema_version": {"const": "hive-public-memory-envelope/v1"},
    "release_policy": {"const": "hive-safe-public-memory-release/v1"},
    "record_id": {"type": "string", "minLength": 1, "maxLength": 4096},
    "record_type": {"const": "memory-record"},
    "source_schema": {"const": "memory-record-v1"},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 4096},
    "repository_id": {"type": "string", "minLength": 1, "maxLength": 4096},
    "source_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_previous_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "actor_id": {"type": "string", "minLength": 1, "maxLength": 4096},
    "observed_at": {"type": "string", "minLength": 1, "maxLength": 4096},
    "recorded_at": {"type": "string", "minLength": 1, "maxLength": 4096},
    "status": {"type": "string", "minLength": 1, "maxLength": 4096},
    "sensitivity": {"const": "safe-public"},
    "public_release_decision_id": {"type": "string", "minLength": 1, "maxLength": 4096},
    "public_release_decided_by": {"type": "string", "minLength": 1, "maxLength": 4096},
    "public_release_subject_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "payload": {
      "type": "object",
      "required": ["record_type", "schema_version", "memory_id", "memory_kind", "repository_id", "tenant_id", "mission_id", "run_id", "step_id", "actor_id", "payload_digest", "previous_record_id", "supersedes_record_id", "observed_at", "recorded_at", "causation_id", "correlation_id", "source_refs", "claim_refs", "evidence_refs", "court_refs", "code_receipt_refs", "generation_refs", "status", "confidence_ppm", "freshness_expires_at", "contradiction_refs", "relation_refs", "owner_id", "sensitivity", "access_purpose", "retention", "deletion_policy", "quarantine_state", "appeal_state", "content_digest"],
      "properties": {
        "record_type": {"const": "memory-record"},
        "schema_version": {"const": 1},
        "memory_id": {"type": "string", "minLength": 1, "maxLength": 4096},
        "memory_kind": {"type": "string", "enum": ["working", "episodic", "semantic", "procedural", "prospective", "decision", "opportunity", "counterfactual", "social", "evaluation", "resource", "governance", "not-applicable"]},
        "repository_id": {"type": "string", "minLength": 1, "maxLength": 4096},
        "tenant_id": {"type": "string", "minLength": 1, "maxLength": 4096},
        "mission_id": {"type": ["string", "null"], "maxLength": 4096},
        "run_id": {"type": ["string", "null"], "maxLength": 4096},
        "step_id": {"type": ["string", "null"], "maxLength": 4096},
        "actor_id": {"type": "string", "minLength": 1, "maxLength": 4096},
        "payload_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "previous_record_id": {"type": ["string", "null"], "maxLength": 4096},
        "supersedes_record_id": {"type": ["string", "null"], "maxLength": 4096},
        "observed_at": {"type": "string", "minLength": 1, "maxLength": 4096},
        "recorded_at": {"type": "string", "minLength": 1, "maxLength": 4096},
        "causation_id": {"type": ["string", "null"], "maxLength": 4096},
        "correlation_id": {"type": ["string", "null"], "maxLength": 4096},
        "source_refs": {"type": "array", "uniqueItems": true, "maxItems": 256, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
        "claim_refs": {"type": "array", "uniqueItems": true, "maxItems": 256, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
        "evidence_refs": {"type": "array", "uniqueItems": true, "maxItems": 256, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
        "court_refs": {"type": "array", "uniqueItems": true, "maxItems": 256, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
        "code_receipt_refs": {"type": "array", "uniqueItems": true, "maxItems": 256, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
        "generation_refs": {"type": "array", "uniqueItems": true, "maxItems": 256, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
        "status": {"type": "string", "enum": ["active", "superseded", "tombstoned", "quarantined"]},
        "confidence_ppm": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000},
        "freshness_expires_at": {"type": ["string", "null"], "maxLength": 4096},
        "contradiction_refs": {"type": "array", "uniqueItems": true, "maxItems": 256, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
        "relation_refs": {"type": "array", "uniqueItems": true, "maxItems": 256, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
        "owner_id": {"type": "string", "minLength": 1, "maxLength": 4096},
        "sensitivity": {"const": "safe-public"},
        "access_purpose": {"type": "string", "minLength": 1, "maxLength": 4096},
        "retention": {"type": "string", "minLength": 1, "maxLength": 4096},
        "deletion_policy": {"type": "string", "minLength": 1, "maxLength": 4096},
        "quarantine_state": {"const": "none"},
        "appeal_state": {"type": "string", "minLength": 1, "maxLength": 4096},
        "content_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
