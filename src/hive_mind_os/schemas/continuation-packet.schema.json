{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive-mind-os.invalid/schemas/v1/continuation-packet.schema.json",
  "title": "Hive Mind OS Autonomous Continuation Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "created_at", "repository", "objective", "scope", "granted_authority", "forbidden_authority", "verified_artifacts", "decision", "independent_verification", "blockers", "next_action", "resume_instruction", "integrity"],
  "properties": {
    "schema_version": {"const": 1},
    "packet_id": {"type": "string", "minLength": 3, "maxLength": 96, "pattern": "CP-[A-Za-z0-9._-]+"},
    "created_at": {"type": "string", "format": "date-time"},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path_policy", "path", "expected_commit", "worktree_clean"],
      "properties": {
        "path_policy": {"const": "absolute-local-path"},
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "expected_commit": {"type": "string", "pattern": "[0-9a-f]{40}"},
        "worktree_clean": {"const": true}
      }
    },
    "objective": {"type": "string", "minLength": 1, "maxLength": 500},
    "scope": {"type": "string", "minLength": 1, "maxLength": 500},
    "granted_authority": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["read_repository", "write_local", "run_local_tests", "create_local_commit"]}},
    "forbidden_authority": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["network", "remote_git", "credentials", "secrets", "external_message", "deploy", "payment", "policy_mutation"]}},
    "verified_artifacts": {"type": "array", "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": {"path": {"type": "string", "format": "portable-relative-path"}, "digest": {"type": "string", "pattern": "sha256:[0-9a-f]{64}"}}}},
    "decision": {"enum": ["approved", "not-approved", "blocked", "no-decision"]},
    "reason": {"type": "string", "minLength": 1, "maxLength": 240},
    "independent_verification": {"type": "array", "maxItems": 16, "items": {"type": "object", "additionalProperties": false, "required": ["verifier_id", "decision"], "properties": {"verifier_id": {"type": "string", "minLength": 3, "maxLength": 96, "pattern": "[A-Za-z0-9][A-Za-z0-9._-]+"}, "decision": {"enum": ["approved", "not-approved", "blocked", "no-decision"]}}}},
    "blockers": {"type": "array", "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["kind", "summary"], "properties": {"kind": {"enum": ["external-authority-required", "evidence", "environment", "other"]}, "summary": {"type": "string", "minLength": 1, "maxLength": 240}}}},
    "next_action": {"type": "object", "additionalProperties": false, "required": ["action", "success_condition", "stopping_condition"], "properties": {"action": {"type": "string", "minLength": 1, "maxLength": 240}, "success_condition": {"type": "string", "minLength": 1, "maxLength": 240}, "stopping_condition": {"type": "string", "minLength": 1, "maxLength": 240}}},
    "resume_instruction": {"type": "string", "minLength": 1, "maxLength": 240},
    "integrity": {"type": "object", "additionalProperties": false, "required": ["algorithm", "canonical_digest"], "properties": {"algorithm": {"const": "sha256"}, "canonical_digest": {"type": "string", "pattern": "sha256:[0-9a-f]{64}"}}}
  }
}
