{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive-mind-os.invalid/schemas/v1/event.schema.json",
  "title": "Hive Mind OS Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "event_type", "stream_id", "stream_version", "actor_id", "occurred_at", "payload_digest", "payload"],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "minLength": 1},
    "event_type": {"type": "string", "minLength": 1},
    "stream_id": {"type": "string", "minLength": 1},
    "stream_version": {"type": "integer", "minimum": 1},
    "actor_id": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "causation_id": {"type": ["string", "null"], "minLength": 1},
    "correlation_id": {"type": ["string", "null"], "minLength": 1},
    "previous_event_digest": {"type": ["string", "null"], "maxLength": 71, "pattern": "^sha256:[0-9a-f]{64}$"},
    "payload_digest": {"type": "string", "maxLength": 71, "pattern": "^sha256:[0-9a-f]{64}$"},
    "payload": {"type": "object"}
  }
}
