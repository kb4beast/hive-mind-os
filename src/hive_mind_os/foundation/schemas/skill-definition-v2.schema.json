{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive-mind-os.invalid/contracts/skill-definition/v2",
  "type": "object",
  "required": ["record_type", "schema_version", "skill_id", "version", "purpose", "input_schema", "output_schema", "requested_capabilities", "side_effects", "rollback", "activation"],
  "properties": {
    "record_type": {"const": "skill-definition"},
    "schema_version": {"const": 2},
    "skill_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "input_schema": {"type": "string", "minLength": 1},
    "output_schema": {"type": "string", "minLength": 1},
    "requested_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "side_effects": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "rollback": {"type": "string", "minLength": 1},
    "activation": {"const": "inert"}
  },
  "additionalProperties": false
}
