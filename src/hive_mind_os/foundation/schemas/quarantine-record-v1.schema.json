{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive-mind-os.invalid/contracts/quarantine-record/v1",
  "type": "object",
  "required": ["record_type", "schema_version", "quarantine_id", "subject_id", "scope", "reason_code", "evidence_refs", "issued_by", "appeal_state", "enforcement"],
  "properties": {
    "record_type": {"const": "quarantine-record"},
    "schema_version": {"const": 1},
    "quarantine_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "reason_code": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "issued_by": {"type": "string", "minLength": 1},
    "appeal_state": {"type": "string", "enum": ["available", "filed", "granted", "denied"]},
    "enforcement": {"const": "none-phase2"}
  },
  "additionalProperties": false
}
