{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://hive-mind-os.invalid/schemas/v1/campaign-mission.schema.json","type":"object","additionalProperties":false,"required":["schema_version","revision","mission_id","objective","target_boundary","requirement_ids","packages","authority_digest","state","created_at","parent_digest"],"properties":{"schema_version":{"const":1},"revision":{"type":"integer","minimum":1},"mission_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},"objective":{"type":"string","minLength":1,"maxLength":4000},"target_boundary":{"type":"string","format":"portable-relative-path","minLength":1,"maxLength":1024},"requirement_ids":{"type":"array","minItems":1,"maxItems":128,"uniqueItems":true,"items":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"}},"packages":{"type":"array","minItems":1,"maxItems":128,"items":{"$ref":"work-package.schema.json"}},"authority_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"state":{"enum":["DRAFT","READY","RUNNING","VERIFYING","COMPLETED","NO_CHANGE","FAILED","CANCELLED"]},"created_at":{"type":"string","format":"date-time"},"parent_digest":{"type":["string","null"],"pattern":"^sha256:[0-9a-f]{64}$"}}}
