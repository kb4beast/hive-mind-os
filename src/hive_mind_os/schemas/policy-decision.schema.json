{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive-mind-os.invalid/schemas/v1/policy-decision.schema.json",
  "title": "Hive Mind OS Policy Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "policy_version", "actor_id", "mission_id", "action_digest", "decision", "reasons", "decided_at"],
  "properties": {
    "schema_version": {"const": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "actor_id": {"type": "string", "minLength": 1},
    "mission_id": {"type": "string", "minLength": 1},
    "action_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "decision": {"enum": ["allow", "deny", "quarantine", "require_grant"]},
    "reasons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "decided_at": {"type": "string", "format": "date-time"},
    "grant_ref": {"type": ["string", "null"], "minLength": 1}
  }
}
