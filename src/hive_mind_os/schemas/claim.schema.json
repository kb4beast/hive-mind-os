{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive-mind-os.invalid/schemas/v1/claim.schema.json",
  "title": "Hive Mind OS Atomic Claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "case_id", "proposition", "source_ids", "category", "burden", "implementation_state", "capability_maturity"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^CLM-[0-9]{3,}$"},
    "case_id": {"type": "string", "pattern": "^CASE-[0-9]{3,}$"},
    "proposition": {"type": "string", "minLength": 1},
    "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^SRC-[0-9]{3,}$"}},
    "category": {"type": "string", "minLength": 1},
    "burden": {"enum": ["capture", "design", "implement", "promote", "superiority"]},
    "implementation_state": {"enum": ["inventoried", "planned", "implemented", "validated"]},
    "capability_maturity": {"enum": ["specified", "structurally_prototyped", "executed_in_isolation", "independently_verified_e2e", "production_proven"]},
    "architecture_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "acceptance_tests": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "code_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "test_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "outcome_metrics": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "blocked_by": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
