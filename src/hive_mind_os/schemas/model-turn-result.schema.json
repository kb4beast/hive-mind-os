{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive-mind-os.invalid/schemas/v1/model-turn-result.schema.json",
  "title": "Hive Mind OS Durable Model Turn Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "logical_turn_id", "outcome", "response_digest", "structured_result_digest", "prompt_tokens", "completion_tokens", "transport_retry_index"],
  "properties": {
    "schema_version": {"const": 1},
    "logical_turn_id": {"type": "string", "pattern": "^MTURN-[0-9a-f]{64}$"},
    "outcome": {"type": "string", "enum": ["succeeded", "invalid_output", "provider_response_failure"]},
    "response_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "structured_result_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "prompt_tokens": {"type": ["integer", "null"], "minimum": 0},
    "completion_tokens": {"type": ["integer", "null"], "minimum": 0},
    "transport_retry_index": {"type": "integer", "minimum": 0}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "succeeded"}}},
      "then": {"properties": {"structured_result_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}
    },
    {
      "if": {"properties": {"outcome": {"enum": ["invalid_output", "provider_response_failure"]}}},
      "then": {"properties": {"structured_result_digest": {"type": "null"}}}
    }
  ]
}
