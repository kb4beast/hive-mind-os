{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive-mind-os.invalid/contracts/cognitive-view-result/v1",
  "type": "object",
  "required": ["schema_version", "status", "tenant_id", "repository_id", "repository_identity_digest", "namespace_path", "manifest_digest", "source_manifest_digest", "source_cursor", "tree_digest", "base_count", "canvas_count", "recovery_status", "conflict_paths", "receipt_path"],
  "properties": {
    "schema_version": {"const": "hive-cognitive-view-result/v1"},
    "status": {"type": "string", "enum": ["projected", "unchanged", "drift", "conflict"]},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 4096},
    "repository_id": {"type": "string", "minLength": 1, "maxLength": 4096},
    "repository_identity_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "namespace_path": {"type": "string", "minLength": 1, "maxLength": 32767},
    "manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_cursor": {"type": "string", "pattern": "^memory-set:[0-9a-f]{64}$"},
    "tree_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "base_count": {"const": 4},
    "canvas_count": {"const": 1},
    "recovery_status": {"type": "string", "enum": ["committed", "recovered", "not-required", "read-only", "conflict-preserved"]},
    "conflict_paths": {"type": "array", "maxItems": 200, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 240}},
    "receipt_path": {"type": ["string", "null"], "maxLength": 32767}
  },
  "additionalProperties": false
}
