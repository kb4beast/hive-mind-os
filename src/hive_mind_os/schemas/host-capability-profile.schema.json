{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive-mind-os.invalid/schemas/v1/host-capability-profile.schema.json",
  "title": "Hive Mind OS Host Capability Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "host_id",
    "host_version_ref",
    "adapter_version",
    "evidence_level",
    "conformance_status",
    "capabilities",
    "evidence_refs",
    "evidence_obligations"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "host_id": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
    "host_version_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "adapter_version": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "evidence_level": {
      "type": "string",
      "enum": ["declared", "documented", "tested"]
    },
    "conformance_status": {
      "type": "string",
      "enum": ["unverified", "failed", "passed"]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "package_discovery",
          "instruction_projection",
          "skill_md",
          "custom_agents",
          "agent_tool_restriction",
          "mcp_client",
          "lifecycle_hooks",
          "worktree_isolation",
          "background_agents",
          "resume",
          "structured_output",
          "event_stream",
          "cancellation",
          "receipts"
        ]
      },
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": ".*\\S.*"
      },
      "uniqueItems": true
    },
    "evidence_obligations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": ".*\\S.*"
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {"properties": {"conformance_status": {"const": "passed"}}},
      "then": {
        "properties": {
          "evidence_level": {"const": "tested"},
          "evidence_obligations": {"maxItems": 0}
        }
      }
    }
  ]
}
