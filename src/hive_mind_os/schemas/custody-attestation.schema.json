{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive-mind-os.invalid/schemas/v1/custody-attestation.schema.json",
  "title": "Hive Mind OS External Custody Attestation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "attestation_id", "authority_id", "keyset_sequence", "signer_identity", "key_id", "algorithm", "audience", "issued_at", "expires_at", "nonce", "subject", "signature"],
  "properties": {
    "schema_version": {"const": 1},
    "attestation_id": {"type": "string", "minLength": 1},
    "authority_id": {"type": "string", "minLength": 1},
    "keyset_sequence": {"type": "integer", "minimum": 1},
    "signer_identity": {"type": "string", "minLength": 1},
    "key_id": {"type": "string", "minLength": 1},
    "algorithm": {"const": "ed25519"},
    "audience": {"const": "hive-mind-os/custody/v1"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "nonce": {"type": "string", "minLength": 16, "maxLength": 256, "pattern": "^[A-Za-z0-9_-]+$"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "mission_id", "state_ref", "subject_id", "digest", "bindings"],
      "properties": {
        "kind": {"enum": ["mission-configuration", "tool-receipt"]},
        "mission_id": {"type": "string", "minLength": 1},
        "state_ref": {"type": "string", "minLength": 1},
        "subject_id": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "maxLength": 71, "pattern": "^sha256:[0-9a-f]{64}$"},
        "bindings": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
      }
    },
    "signature": {"type": "string", "minLength": 86, "maxLength": 86, "pattern": "^[A-Za-z0-9_-]+$"}
  }
}
