{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive-mind-os.invalid/schemas/v1/hard-isolation-receipt.schema.json",
  "title": "Hive Mind OS Hard Isolation Controller Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "execution_id", "execution_plan_digest", "intent_digest", "profile_id", "profile_digest", "runtime", "runtime_digest", "image_digest", "guest_executable_digest", "source_snapshot_digest", "controller_identity", "actor_id", "outcome", "exit_code", "output_digest", "output_bytes", "mounts_enforced", "network_enforced", "resource_limits_enforced", "cleanup_completed", "observed_at", "adapter_version"],
  "properties": {
    "schema_version": {"const": 1},
    "receipt_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "execution_id": {"type": "string", "pattern": "^HIEXEC-[0-9a-f]{64}$"},
    "execution_plan_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "intent_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "profile_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "profile_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "runtime": {"enum": ["oci-container", "hyperv-container", "ephemeral-vm"]},
    "runtime_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "guest_executable_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_snapshot_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "controller_identity": {"type": "string", "minLength": 1, "maxLength": 256},
    "actor_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "outcome": {"enum": ["succeeded", "failed", "denied", "timeout"]},
    "exit_code": {"type": ["integer", "null"]},
    "output_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "output_bytes": {"type": "integer", "minimum": 0},
    "mounts_enforced": {"const": true},
    "network_enforced": {"const": true},
    "resource_limits_enforced": {"const": true},
    "cleanup_completed": {"const": true},
    "observed_at": {"type": "string", "minLength": 1, "maxLength": 128},
    "adapter_version": {"type": "string", "minLength": 1, "maxLength": 256}
  }
}
