{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive-mind-os.invalid/schemas/v1/source-lock.schema.json",
  "title": "Hive Mind OS Authenticated Repository Source Lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lock_id", "mission_id", "state_ref", "repository_url", "commit_sha", "tree_sha", "source_identity"],
  "properties": {
    "schema_version": {"const": 1},
    "lock_id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._-]+$"},
    "mission_id": {"type": "string", "minLength": 1},
    "state_ref": {"type": "string", "minLength": 1},
    "repository_url": {"type": "string", "minLength": 1, "maxLength": 2048},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "repository_id", "principal_id"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "repository_id": {"type": "string", "minLength": 1},
        "principal_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
