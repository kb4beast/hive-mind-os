{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive-mind-os.invalid/contracts/usage-event/v1",
  "type": "object",
  "required": ["record_type", "schema_version", "event_kind", "attempt_id", "logical_request_id", "provider_kind", "accounting_status", "adapter_version", "native", "native_provenance", "normalized_axes", "provider_request_id", "served_model_id", "unmapped_path_count", "observation_failure", "correlation", "identity", "inputs", "resources", "cost", "result", "governance"],
  "properties": {
    "record_type": {"const": "usage-event"},
    "schema_version": {"const": 1},
    "event_kind": {"type": "string", "enum": ["attempt-started", "attempt-terminal", "correction", "invoice-observation"]},
    "attempt_id": {"type": "string", "minLength": 1},
    "logical_request_id": {"type": "string", "minLength": 1},
    "provider_kind": {"type": "string", "minLength": 1},
    "accounting_status": {"type": "string", "enum": ["pending", "reported", "unknown", "partial", "conflicting"]},
    "retry_index": {"type": "integer"},
    "purpose": {"type": "string", "minLength": 1},
    "actor_id": {"type": "string", "minLength": 1},
    "request_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "requested_model_id": {"type": ["string", "null"]},
    "served_model_id": {"type": ["string", "null"], "minLength": 1},
    "provider_request_id": {"type": ["string", "null"], "minLength": 1},
    "outcome": {"type": ["string", "null"]},
    "duration_ms": {"type": "number"},
    "error_class": {"type": ["string", "null"]},
    "native": {
      "type": "object",
      "properties": {
        "completion_tokens": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000000000000},
        "completion_tokens_details.reasoning_tokens": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000000000000},
        "prompt_tokens": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000000000000},
        "prompt_tokens_details.cached_tokens": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000000000000},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000000000000},
        "cache_creation_input_tokens": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000000000000},
        "cache_read_input_tokens": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000000000000},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000000000000},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000000000000}
      },
      "additionalProperties": false
    },
    "native_provenance": {
      "type": "object",
      "required": ["source", "unit", "semantics_status", "raw_body_digest"],
      "properties": {
        "source": {"type": "string", "enum": ["response-body", "no-response"]},
        "unit": {"const": "tokens"},
        "semantics_status": {"type": "string", "enum": ["fixture-adapter-unverified", "unknown"]},
        "raw_body_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "normalized_axes": {
      "type": "object",
      "required": ["direction", "cache_input", "modality", "output_kind", "billable"],
      "properties": {
        "direction": {
          "type": "object", "required": ["input", "output", "reported_total", "status"],
          "properties": {
            "input": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000000000000}, "output": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000000000000},
            "reported_total": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000000000000},
            "status": {"type": "string", "enum": ["complete", "unknown", "conflicting"]}
          }, "additionalProperties": false
        },
        "cache_input": {
          "type": "object", "required": ["total", "read", "write", "uncached", "status"],
          "properties": {
            "total": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000000000000}, "read": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000000000000},
            "write": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000000000000}, "uncached": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000000000000},
            "status": {"type": "string", "enum": ["complete", "unknown", "conflicting"]}
          }, "additionalProperties": false
        },
        "modality": {
          "type": "object", "required": ["status"],
          "properties": {"status": {"type": "string", "enum": ["unknown"]}},
          "additionalProperties": false
        },
        "output_kind": {
          "type": "object", "required": ["total", "reasoning_subset", "status"],
          "properties": {
            "total": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000000000000}, "reasoning_subset": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000000000000},
            "status": {"type": "string", "enum": ["partial", "unknown", "conflicting"]}
          }, "additionalProperties": false
        },
        "billable": {
          "type": "object", "required": ["status"],
          "properties": {"status": {"type": "string", "enum": ["unknown"]}},
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "unmapped_path_count": {"type": "integer", "minimum": 0},
    "observation_failure": {"type": ["string", "null"]},
    "adapter_version": {"type": ["string", "null"]},
    "trace_id": {"type": ["string", "null"]},
    "budget_lease_id": {"type": ["string", "null"]},
    "response_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "correlation": {
      "type": "object",
      "required": ["repository_id", "tenant_id", "mission_id", "run_id", "step_id", "role", "work_item_id", "idea_id", "case_id", "experiment_id", "trace_id", "span_id", "logical_request_id", "attempt_id", "provider_request_id"],
      "properties": {
        "repository_id": {"type": "string", "minLength": 1}, "tenant_id": {"type": "string", "minLength": 1},
        "mission_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256}, "run_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256}, "step_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "role": {"type": ["string", "null"], "minLength": 1, "maxLength": 256}, "work_item_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256}, "idea_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "case_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256}, "experiment_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256}, "trace_id": {"type": "string", "minLength": 1},
        "span_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256}, "logical_request_id": {"type": "string", "minLength": 1},
        "attempt_id": {"type": "string", "minLength": 1}, "provider_request_id": {"type": ["string", "null"]}
      }, "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "required": ["acting_identity", "court_purpose", "court_stance", "evaluation_arm", "provider_kind", "requested_model_id", "served_model_id", "model_revision", "host_id", "adapter_version"],
      "properties": {
        "acting_identity": {"type": "string", "minLength": 1}, "court_purpose": {"type": "string", "minLength": 1},
        "court_stance": {"type": "string", "enum": ["advocate", "cross-examiner", "judge", "witness", "none"]},
        "evaluation_arm": {"type": "string", "enum": ["champion", "challenger", "none", "unknown"]},
        "provider_kind": {"type": "string", "minLength": 1}, "requested_model_id": {"type": "string", "minLength": 1},
        "served_model_id": {"type": ["string", "null"]}, "model_revision": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "host_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256}, "adapter_version": {"type": "string", "minLength": 1}
      }, "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "required": ["request_digest", "prompt_layer_digest", "context_digest", "memory_selection_digest", "selected_count", "omitted_count", "bodies_persisted"],
      "properties": {
        "request_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "prompt_layer_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "context_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}, "memory_selection_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "selected_count": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000000}, "omitted_count": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000000},
        "bodies_persisted": {"const": false}
      }, "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "required": ["elapsed_ms", "compute_ms", "peak_memory_bytes", "energy_joules", "budget_lease_id", "reservation", "consumption", "retry_index", "loop_signal_id", "tool_id"],
      "properties": {
        "elapsed_ms": {"type": ["number", "null"], "minimum": 0}, "budget_lease_id": {"type": ["string", "null"]},
        "compute_ms": {"type": ["number", "null"], "minimum": 0}, "peak_memory_bytes": {"type": ["integer", "null"], "minimum": 0},
        "energy_joules": {"type": ["number", "null"], "minimum": 0},
        "reservation": {"type": ["string", "null"]}, "consumption": {"type": ["string", "null"]},
        "retry_index": {"type": "integer", "minimum": 0}, "loop_signal_id": {"type": ["string", "null"]},
        "tool_id": {"type": ["string", "null"]}
      }, "additionalProperties": false
    },
    "cost": {
      "type": "object",
      "required": ["amount", "currency", "price_card_version", "provenance", "uncertainty"],
      "properties": {
        "amount": {"type": ["string", "null"]}, "currency": {"type": ["string", "null"]},
        "price_card_version": {"type": ["string", "null"]}, "provenance": {"type": "string", "minLength": 1},
        "uncertainty": {"type": "string", "minLength": 1}
      }, "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": ["outcome", "terminal_relationship", "error_class", "redaction", "progress_fingerprint", "value_link"],
      "properties": {
        "outcome": {"type": ["string", "null"]}, "terminal_relationship": {"type": "string", "enum": ["pending", "terminal"]},
        "error_class": {"type": ["string", "null"]}, "redaction": {"const": "bodies-excluded"},
        "progress_fingerprint": {"type": ["string", "null"]}, "value_link": {"type": ["string", "null"]}
      }, "additionalProperties": false
    },
    "governance": {
      "type": "object",
      "required": ["sensitivity", "retention", "consent_policy", "quarantine_state", "exporter", "deletion_status", "reconciliation_status", "access_purpose", "access_audit_ref"],
      "properties": {
        "sensitivity": {"const": "private"}, "retention": {"type": "string", "minLength": 1},
        "consent_policy": {"type": "string", "minLength": 1}, "quarantine_state": {"type": "string", "minLength": 1},
        "exporter": {"const": "disabled"}, "deletion_status": {"type": "string", "minLength": 1},
        "reconciliation_status": {"type": "string", "minLength": 1},
        "access_purpose": {"type": "string", "minLength": 1}, "access_audit_ref": {"type": ["string", "null"], "minLength": 1, "maxLength": 256}
      }, "additionalProperties": false
    }
  },
  "additionalProperties": false
}
