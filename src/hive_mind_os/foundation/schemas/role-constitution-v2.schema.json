{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive-mind-os.invalid/contracts/role-constitution/v2",
  "type": "object",
  "required": ["record_type", "schema_version", "role_id", "mission", "authority_ceiling", "forbidden_actions", "evidence_duties", "outputs"],
  "properties": {
    "record_type": {"const": "role-constitution"},
    "schema_version": {"const": 2},
    "role_id": {"type": "string", "enum": ["orchestrator", "explorer", "architect", "builder", "curator", "integrator", "steward", "optimizer"]},
    "mission": {"type": "string", "minLength": 1},
    "authority_ceiling": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "forbidden_actions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence_duties": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
