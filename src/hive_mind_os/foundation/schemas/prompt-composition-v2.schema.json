{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive-mind-os.invalid/contracts/prompt-composition/v2",
  "type": "object",
  "required": ["record_type", "schema_version", "generator_version", "source_digest", "outputs", "activation"],
  "properties": {
    "record_type": {"const": "prompt-composition"},
    "schema_version": {"const": 2},
    "generator_version": {"type": "string", "minLength": 1},
    "source_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "digest"],
        "properties": {
          "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "activation": {"const": "inert"}
  },
  "additionalProperties": false
}
