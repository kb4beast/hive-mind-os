{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive-mind-os.invalid/contracts/memory-record/v1",
  "type": "object",
  "required": ["record_type", "schema_version", "memory_id", "memory_kind", "repository_id", "tenant_id", "content_digest", "provenance_refs", "sensitivity", "retention", "status"],
  "properties": {
    "record_type": {"const": "memory-record"},
    "schema_version": {"const": 1},
    "memory_id": {"type": "string", "minLength": 1},
    "memory_kind": {"type": "string", "enum": ["action", "decision", "handoff", "failure", "learning", "not-applicable"]},
    "repository_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "content_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "protected_content_ref": {"type": ["string", "null"]},
    "provenance_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "sensitivity": {"type": "string", "enum": ["private", "internal", "safe-public"]},
    "retention": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["active", "superseded", "tombstoned", "quarantined"]}
  },
  "additionalProperties": false
}
