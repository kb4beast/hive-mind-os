{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive-mind-os.invalid/schemas/v1/ooda-state.schema.json",
  "title": "Hive Mind OS Replay-Only OODA State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cycle_id",
    "mission_id",
    "iteration",
    "phase",
    "status",
    "sequence",
    "last_transition",
    "stop_reason",
    "terminal_record"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "cycle_id": {"type": "string", "minLength": 1},
    "mission_id": {"type": "string", "minLength": 1},
    "iteration": {"type": "integer", "minimum": 1},
    "phase": {
      "type": "string",
      "enum": ["observe", "orient", "decide", "act"]
    },
    "status": {
      "type": "string",
      "enum": ["running", "succeeded", "blocked", "failed"]
    },
    "sequence": {"type": "integer", "minimum": 0},
    "last_transition": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "sequence",
        "from_phase",
        "to_phase",
        "actor_id",
        "occurred_at",
        "evidence_refs",
        "decision_ref",
        "policy_decision_ref",
        "action_intent_ref",
        "action_receipt_ref",
        "outcome_ref"
      ],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "from_phase": {
          "type": "string",
          "enum": ["observe", "orient", "decide", "act"]
        },
        "to_phase": {
          "type": "string",
          "enum": ["observe", "orient", "decide", "act"]
        },
        "actor_id": {"type": "string", "minLength": 1},
        "occurred_at": {"type": "string", "format": "date-time"},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "decision_ref": {"type": ["string", "null"], "minLength": 1},
        "policy_decision_ref": {"type": ["string", "null"], "minLength": 1},
        "action_intent_ref": {"type": ["string", "null"], "minLength": 1},
        "action_receipt_ref": {"type": ["string", "null"], "minLength": 1},
        "outcome_ref": {"type": ["string", "null"], "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"from_phase": {"const": "observe"}}},
          "then": {"properties": {"to_phase": {"const": "orient"}}}
        },
        {
          "if": {"properties": {"from_phase": {"const": "orient"}}},
          "then": {"properties": {"to_phase": {"const": "decide"}}}
        },
        {
          "if": {"properties": {"from_phase": {"const": "decide"}}},
          "then": {"properties": {"to_phase": {"const": "act"}}}
        },
        {
          "if": {"properties": {"from_phase": {"const": "act"}}},
          "then": {
            "properties": {
              "to_phase": {"const": "observe"},
              "action_receipt_ref": {"type": "string", "minLength": 1},
              "outcome_ref": {"type": "string", "minLength": 1}
            }
          }
        },
        {
          "if": {"properties": {"to_phase": {"const": "act"}}},
          "then": {
            "properties": {
              "decision_ref": {"type": "string", "minLength": 1},
              "policy_decision_ref": {"type": "string", "minLength": 1},
              "action_intent_ref": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "stop_reason": {"type": ["string", "null"], "minLength": 1},
    "terminal_record": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "sequence",
        "status",
        "actor_id",
        "occurred_at",
        "evidence_refs",
        "outcome_ref",
        "reason"
      ],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "status": {
          "type": "string",
          "enum": ["succeeded", "blocked", "failed"]
        },
        "actor_id": {"type": "string", "minLength": 1},
        "occurred_at": {"type": "string", "format": "date-time"},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "outcome_ref": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "running"}}},
      "then": {
        "properties": {
          "stop_reason": {"const": null},
          "terminal_record": {"const": null}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "succeeded"}}},
      "then": {
        "properties": {
          "stop_reason": {"type": "string", "minLength": 1},
          "terminal_record": {
            "type": "object",
            "properties": {"status": {"const": "succeeded"}}
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "blocked"}}},
      "then": {
        "properties": {
          "stop_reason": {"type": "string", "minLength": 1},
          "terminal_record": {
            "type": "object",
            "properties": {"status": {"const": "blocked"}}
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "failed"}}},
      "then": {
        "properties": {
          "stop_reason": {"type": "string", "minLength": 1},
          "terminal_record": {
            "type": "object",
            "properties": {"status": {"const": "failed"}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {"const": "observe"},
          "last_transition": {"type": "object"}
        }
      },
      "then": {
        "properties": {
          "last_transition": {
            "type": "object",
            "properties": {"to_phase": {"const": "observe"}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {"const": "orient"},
          "last_transition": {"type": "object"}
        }
      },
      "then": {
        "properties": {
          "last_transition": {
            "type": "object",
            "properties": {"to_phase": {"const": "orient"}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {"const": "decide"},
          "last_transition": {"type": "object"}
        }
      },
      "then": {
        "properties": {
          "last_transition": {
            "type": "object",
            "properties": {"to_phase": {"const": "decide"}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {"const": "act"},
          "last_transition": {"type": "object"}
        }
      },
      "then": {
        "properties": {
          "last_transition": {
            "type": "object",
            "properties": {"to_phase": {"const": "act"}}
          }
        }
      }
    }
  ]
}
