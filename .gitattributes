# Repository-authored text remains normalized and reproducible.
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Source exhibits are evidentiary bytes. Never normalize line endings or text diffs.
evidence/sources/**/raw/** -text -diff

# Live receipts and provider artifacts are evidentiary bytes. Preserve them exactly.
evidence/live/** -text -diff

# Benchmark receipts are also evidentiary bytes. Their recorded digests bind the exact
# repository bytes, so checkout must never rewrite JSONL line endings.
evidence/benchmarks/** -text -diff

# Prompt-experiment artifacts are retained evidence, including JSON reports and command
# streams generated on Windows. Git must preserve their pre-commit bytes exactly.
evidence/experiments/_artifacts/** -text -diff
