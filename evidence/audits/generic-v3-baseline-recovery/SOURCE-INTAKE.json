  "atomic_claims": [
    {
      "claim_id": "CLM-V3R-001",
      "source_ids": [
        "SRC-V3R-GIT-BUNDLE-001"
      ],
      "statement": "A Git bundle is an offline transport containing refs and Git objects."
    },
    {
      "claim_id": "CLM-V3R-002",
      "source_ids": [
        "SRC-V3R-GIT-BUNDLE-001"
      ],
      "statement": "git bundle verify checks the bundle format and whether prerequisite commits exist and are fully linked in the receiving repository."
    },
    {
      "claim_id": "CLM-V3R-003",
      "source_ids": [
        "SRC-V3R-PYTHON-STAT-001"
      ],
      "statement": "Python 3.12 added st_birthtime and st_birthtime_ns on Windows for file creation time."
    },
    {
      "claim_id": "CLM-V3R-004",
      "source_ids": [
        "SRC-V3R-PYTHON-STAT-001"
      ],
      "statement": "Python 3.12 deprecated st_ctime and st_ctime_ns on Windows and documents a future metadata-change-time meaning."
    },
    {
      "claim_id": "CLM-V3R-005",
      "source_ids": [
        "SRC-V3R-MICROSOFT-FILE-BASIC-INFO-001"
      ],
      "statement": "FILE_BASIC_INFO exposes CreationTime, LastWriteTime, and ChangeTime as separate fields."
    },
    {
      "claim_id": "CLM-V3R-006",
      "source_ids": [
        "SRC-V3R-MICROSOFT-FILE-BASIC-INFO-001"
      ],
      "statement": "Microsoft distinguishes LastWriteTime for the underlying data stream from ChangeTime for file metadata changes."
    },
    {
      "claim_id": "CLM-V3R-007",
      "source_ids": [
        "SRC-V3R-PR154-001"
      ],
      "statement": "Pull request 154 closed as merged with final head 28463ae6dd842b0b316fcf99eab98804cdaf9735 and merge commit 59a5364501c5e49ceb28574aad7a4ac1512291b9."
    },
    {
      "claim_id": "CLM-V3R-008",
      "source_ids": [
        "SRC-V3R-PR154-001"
      ],
      "statement": "Pull request 154 records base commit 44224532dc25b94a95c3184054ec81762a258259 and merged_at 2026-08-23T23:51:32Z."
    },
    {
      "claim_id": "CLM-V3R-009",
      "source_ids": [
        "SRC-V3R-CI32674854589-001"
      ],
      "statement": "Constitutional CI run 32674854589 completed with failure for head commit 59a5364501c5e49ceb28574aad7a4ac1512291b9."
    },
    {
      "claim_id": "CLM-V3R-010",
      "source_ids": [
        "SRC-V3R-CI32674854589-001"
      ],
      "statement": "The Linux Python 3.11, 3.12, and 3.14 and Windows Python 3.12 unit jobs failed; their archived logs show the child clone's switch to 9b1cbcfe500e2253c70cb407b6c5e0493b63aaa8 returned exit status 128."
    }
  ],
  "counterclaims": [
    {
      "counterclaim_id": "CTR-V3R-001",
      "source_ids": [
        "SRC-V3R-GIT-BUNDLE-001"
      ],
      "statement": "Bundle verification establishes format and prerequisite integrity, not publisher authenticity or trust; the local correction separately binds the bundle bytes, advertised ref, commits, and trees."
    },
    {
      "counterclaim_id": "CTR-V3R-002",
      "source_ids": [
        "SRC-V3R-PYTHON-STAT-001"
      ],
      "statement": "Timestamp meaning, availability, and resolution remain operating-system and filesystem dependent; st_birthtime is not a portable field outside the supported Windows boundary."
    },
    {
      "counterclaim_id": "CTR-V3R-003",
      "source_ids": [
        "SRC-V3R-MICROSOFT-FILE-BASIC-INFO-001"
      ],
      "statement": "Windows timestamps describe filesystem observations and cannot detect an entire write-and-restore between observation points."
    },
    {
      "counterclaim_id": "CTR-V3R-004",
      "source_ids": [
        "SRC-V3R-PYTHON-STAT-001",
        "SRC-V3R-MICROSOFT-FILE-BASIC-INFO-001"
      ],
      "statement": "Timestamp continuity does not authenticate executable content; native-image validation and SHA-256 of the exact bytes remain independent requirements."
    },
    {
      "counterclaim_id": "CTR-V3R-005",
      "source_ids": [
        "SRC-V3R-PR154-001",
        "SRC-V3R-CI32674854589-001"
      ],
      "statement": "GitHub API endpoints are mutable provider views; the archive preserves only the exact point-in-time response bytes and must be checked against Git object identities."
    },
    {
      "counterclaim_id": "CTR-V3R-006",
      "source_ids": [
        "SRC-V3R-CI32674854589-001"
      ],
      "statement": "A failed CI result and its reproduced cause establish an adverse observation, not candidate qualification, activation authority, or production readiness."
    }
  ],
  "disposition": "ADAPT_PENDING_DISTINCT_JUDGE"
}
