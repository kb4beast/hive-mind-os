{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hive-mind-os/whole-os-service-config/v1",
  "title": "Whole-OS service configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "tenant_id", "repository_id", "state_dir", "binding_descriptor", "graph", "maximum_attempts"],
  "properties": {
    "schema_version": {"const": 1},
    "campaign_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "repository_id": {"type": "string", "minLength": 1},
    "state_dir": {"type": "string", "minLength": 1},
    "maximum_attempts": {"type": "integer", "minimum": 1},
    "binding_descriptor": {"type": "object", "additionalProperties": false},
    "graph": {"type": "object", "additionalProperties": false}
  }
}
