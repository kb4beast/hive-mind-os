{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive-mind-os.invalid/contracts/cognitive-result/v1",
  "type": "object",
  "required": ["schema_version", "status", "tenant_id", "repository_id", "repository_identity_digest", "namespace_path", "manifest_digest", "source_cursor", "tree_digest", "source_record_count", "projected_record_count", "note_counts", "recovery_status", "conflict_paths", "receipt_path"],
  "properties": {
    "schema_version": {"const": "hive-cognitive-result/v1"},
    "status": {"type": "string", "enum": ["projected", "unchanged", "drift", "conflict"]},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 4096},
    "repository_id": {"type": "string", "minLength": 1, "maxLength": 4096},
    "repository_identity_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "namespace_path": {"type": "string", "minLength": 1, "maxLength": 32767},
    "manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_cursor": {"type": "string", "pattern": "^memory-set:[0-9a-f]{64}$"},
    "tree_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_record_count": {"type": "integer", "minimum": 0, "maximum": 100000},
    "projected_record_count": {"type": "integer", "minimum": 0, "maximum": 100000},
    "note_counts": {
      "type": "object",
      "required": ["ideas", "evidence", "courts", "runs", "agents", "telemetry", "total"],
      "properties": {
        "ideas": {"type": "integer", "minimum": 0, "maximum": 100000},
        "evidence": {"type": "integer", "minimum": 0, "maximum": 100000},
        "courts": {"type": "integer", "minimum": 0, "maximum": 100000},
        "runs": {"type": "integer", "minimum": 0, "maximum": 100000},
        "agents": {"type": "integer", "minimum": 0, "maximum": 100000},
        "telemetry": {"type": "integer", "minimum": 0, "maximum": 100000},
        "total": {"type": "integer", "minimum": 0, "maximum": 100000}
      },
      "additionalProperties": false
    },
    "recovery_status": {"type": "string", "enum": ["committed", "recovered", "already-committed", "not-required", "read-only", "conflict-preserved"]},
    "conflict_paths": {"type": "array", "uniqueItems": true, "maxItems": 100001, "items": {"type": "string", "minLength": 1, "maxLength": 240}},
    "receipt_path": {"type": ["string", "null"], "maxLength": 32767}
  },
  "additionalProperties": false
}
