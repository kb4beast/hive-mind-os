{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive-mind-os.invalid/contracts/brain-receipt/v1",
  "type": "object",
  "required": ["schema_version", "transaction_id", "pack_path", "prior_manifest_digest", "desired_manifest_digest", "authority_decision_id", "authority_actor_id", "authority_lease_id", "attempted_at", "operations", "status", "committed_at", "verified_manifest_digest"],
  "properties": {
    "schema_version": {"const": "hive-brain-projection-receipt/v1"},
    "transaction_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pack_path": {"const": "hive-mind"},
    "prior_manifest_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "desired_manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "authority_decision_id": {"type": "string", "minLength": 1, "maxLength": 4096},
    "authority_actor_id": {"type": "string", "minLength": 1, "maxLength": 4096},
    "authority_lease_id": {"type": "string", "minLength": 1, "maxLength": 4096},
    "attempted_at": {"type": "string", "minLength": 1, "maxLength": 4096},
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100001,
      "items": {
        "type": "object",
        "required": ["path", "expected_prior_digest", "desired_digest"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 240},
          "expected_prior_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
          "desired_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "status": {"const": "committed"},
    "committed_at": {"type": "string", "minLength": 1, "maxLength": 4096},
    "verified_manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
