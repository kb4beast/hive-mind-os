{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive-mind-os.invalid/contracts/memory-record/v1",
  "type": "object",
  "required": ["record_type", "schema_version", "memory_id", "memory_kind", "repository_id", "tenant_id", "mission_id", "run_id", "step_id", "actor_id", "payload_digest", "previous_record_id", "supersedes_record_id", "observed_at", "recorded_at", "causation_id", "correlation_id", "source_refs", "claim_refs", "evidence_refs", "court_refs", "code_receipt_refs", "generation_refs", "status", "confidence_ppm", "freshness_expires_at", "contradiction_refs", "relation_refs", "owner_id", "sensitivity", "access_purpose", "retention", "deletion_policy", "quarantine_state", "appeal_state", "content_digest", "protected_content_ref"],
  "properties": {
    "record_type": {"const": "memory-record"},
    "schema_version": {"const": 1},
    "memory_id": {"type": "string", "minLength": 1},
    "memory_kind": {"type": "string", "enum": ["action", "decision", "handoff", "failure", "learning", "not-applicable"]},
    "repository_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "mission_id": {"type": ["string", "null"]},
    "run_id": {"type": ["string", "null"]},
    "step_id": {"type": ["string", "null"]},
    "actor_id": {"type": "string", "minLength": 1},
    "payload_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "previous_record_id": {"type": ["string", "null"]},
    "supersedes_record_id": {"type": ["string", "null"]},
    "observed_at": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "minLength": 1},
    "causation_id": {"type": ["string", "null"]},
    "correlation_id": {"type": ["string", "null"]},
    "source_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "claim_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "court_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "code_receipt_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "generation_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "confidence_ppm": {"type": ["integer", "null"], "minimum": 0},
    "freshness_expires_at": {"type": ["string", "null"]},
    "contradiction_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "relation_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "owner_id": {"type": "string", "minLength": 1},
    "content_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "protected_content_ref": {"type": ["string", "null"]},
    "sensitivity": {"type": "string", "enum": ["private", "internal", "safe-public"]},
    "access_purpose": {"type": "string", "minLength": 1},
    "retention": {"type": "string", "minLength": 1},
    "deletion_policy": {"type": "string", "minLength": 1},
    "quarantine_state": {"type": "string", "minLength": 1},
    "appeal_state": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["active", "superseded", "tombstoned", "quarantined"]}
  },
  "additionalProperties": false
}
