{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive-mind-os.invalid/schemas/v1/capability-lease.schema.json",
  "title": "Hive Mind OS Capability Lease",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lease_id", "subject_actor_id", "mission_id", "capabilities", "resource_limits", "issued_at", "expires_at", "revocation_ref", "issuer_actor_id"],
  "properties": {
    "schema_version": {"const": 1},
    "lease_id": {"type": "string", "minLength": 1},
    "subject_actor_id": {"type": "string", "minLength": 1},
    "mission_id": {"type": "string", "minLength": 1},
    "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "resource_limits": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "revocation_ref": {"type": "string", "minLength": 1},
    "issuer_actor_id": {"type": "string", "minLength": 1},
    "signature": {"type": ["string", "null"], "minLength": 1}
  }
}
