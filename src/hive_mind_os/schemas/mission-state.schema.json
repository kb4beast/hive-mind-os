{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive-mind-os.invalid/schemas/v1/mission-state.schema.json",
  "title": "Hive Mind OS Portable Mission State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mission", "role_runs", "court_cases", "evidence", "proposed_actions", "tool_receipts", "blockers", "independent_verification", "next_action", "handoff"],
  "properties": {
    "schema_version": {"const": 3},
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state_version", "objective", "active_phase", "active_role", "status", "source_pack_fingerprint"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "state_version": {"type": "integer", "minimum": 1},
        "objective": {"type": "string", "minLength": 1},
        "active_phase": {"enum": ["intake", "discover", "design", "build", "validate", "integrate", "maintain", "optimize", "complete", "blocked", "quarantined"]},
        "active_role": {"enum": ["orchestrator", "explorer", "architect", "builder", "curator", "integrator", "steward", "optimizer"]},
        "status": {"enum": ["active", "complete", "blocked", "quarantined"]},
        "source_pack_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "role_runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "actor_id", "status", "evidence_refs"],
        "properties": {
          "role": {"enum": ["orchestrator", "explorer", "architect", "builder", "curator", "integrator", "steward", "optimizer"]},
          "actor_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pending", "running", "succeeded", "failed", "blocked"]},
          "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    },
    "court_cases": {"type": "array", "items": {"type": "object"}},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "proposed_actions": {"type": "array", "items": {"$ref": "tool-intent.schema.json"}},
    "tool_receipts": {"type": "array", "items": {"$ref": "tool-receipt.schema.json"}},
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "independent_verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actor_id", "evidence_refs"],
        "properties": {
          "actor_id": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_role", "description", "success_condition"],
      "properties": {
        "owner_role": {"enum": ["orchestrator", "explorer", "architect", "builder", "curator", "integrator", "steward", "optimizer"]},
        "description": {"type": "string", "minLength": 1},
        "success_condition": {"type": "string", "minLength": 1}
      }
    },
    "handoff": {"$ref": "handoff.schema.json"}
  },
  "allOf": [
    {
      "if": {"properties": {"mission": {"properties": {"status": {"const": "complete"}}}}},
      "then": {
        "properties": {
          "blockers": {"maxItems": 0},
          "independent_verification": {"minItems": 1}
        }
      }
    }
  ]
}
