{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive-mind-os.invalid/contracts/cognitive-view-canvas/v1",
  "type": "object",
  "required": ["nodes", "edges"],
  "properties": {
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["id", "type", "x", "y", "width", "height"],
        "properties": {
          "id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "type": {"type": "string", "enum": ["text", "file"]},
          "x": {"type": "integer", "minimum": -1000000, "maximum": 1000000},
          "y": {"type": "integer", "minimum": -1000000, "maximum": 1000000},
          "width": {"type": "integer", "minimum": 1, "maximum": 1000000},
          "height": {"type": "integer", "minimum": 1, "maximum": 1000000},
          "text": {"type": "string", "minLength": 1, "maxLength": 4096},
          "file": {"type": "string", "minLength": 1, "maxLength": 240}
        },
        "allOf": [
          {
            "if": {"properties": {"type": {"const": "text"}}},
            "then": {"required": ["text"], "not": {"required": ["file"]}}
          },
          {
            "if": {"properties": {"type": {"const": "file"}}},
            "then": {"required": ["file"], "not": {"required": ["text"]}}
          }
        ],
        "additionalProperties": false
      }
    },
    "edges": {"type": "array", "maxItems": 0, "items": {"type": "object", "additionalProperties": false}}
  },
  "additionalProperties": false
}
