{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive-mind-os.invalid/contracts/cognitive-view-receipt/v1",
  "type": "object",
  "required": ["schema_version", "transaction_id", "tenant_id", "repository_id", "repository_identity_digest", "source_cursor", "source_manifest_digest", "source_receipt_digest", "prior_manifest_digest", "desired_manifest_digest", "authority_decision_id", "authority_actor_id", "authority_lease_id", "attempted_at", "operations", "status", "committed_at", "verified_manifest_digest"],
  "properties": {
    "schema_version": {"const": "hive-cognitive-view-receipt/v1"},
    "transaction_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 4096},
    "repository_id": {"type": "string", "minLength": 1, "maxLength": 4096},
    "repository_identity_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_cursor": {"type": "string", "pattern": "^memory-set:[0-9a-f]{64}$"},
    "source_manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_receipt_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "prior_manifest_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "desired_manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "authority_decision_id": {"type": "string", "minLength": 1, "maxLength": 4096},
    "authority_actor_id": {"type": "string", "minLength": 1, "maxLength": 4096},
    "authority_lease_id": {"type": "string", "minLength": 1, "maxLength": 4096},
    "attempted_at": {"type": "string", "minLength": 1, "maxLength": 4096},
    "operations": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "object", "required": ["path", "expected_prior_digest", "desired_digest"], "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 240}, "expected_prior_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}, "desired_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}}, "additionalProperties": false}},
    "status": {"const": "committed"},
    "committed_at": {"type": "string", "minLength": 1, "maxLength": 4096},
    "verified_manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
