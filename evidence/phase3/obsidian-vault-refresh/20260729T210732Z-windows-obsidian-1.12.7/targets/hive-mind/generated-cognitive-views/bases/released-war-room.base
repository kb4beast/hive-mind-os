filters:
  and:
    - file.inFolder("hive-mind/generated-cognitive")
    - schema_version == "hive-cognitive-note/v1"
    - generator_version == "hive-cognitive-projector/v1"
    - mapping_version == "hive-cognitive-mapping/v1"
    - sensitivity == "safe-public"
    - is_generated == true
    - is_authoritative == false
    - repository_identity_digest == "sha256:bb57656445b8670e8a951de8546fbe2c6204f62a22215180b8d43b623071e4c1"
properties:
  note_id:
    displayName: Generated note ID
  subject_id:
    displayName: Released subject ID
  memory_kind:
    displayName: Released memory kind
  mission_id:
    displayName: Recorded mission ID
  run_id:
    displayName: Recorded run ID
  actor_id:
    displayName: Recorded actor ID
  owner_id:
    displayName: Recorded owner ID
  status:
    displayName: Released record status
  recorded_at:
    displayName: Recorded time (display only)
  source_record_id:
    displayName: Released source record ID
views:
  - type: table
    name: Released static metadata — not live
    order:
      - note_id
      - subject_id
      - memory_kind
      - mission_id
      - run_id
      - actor_id
      - owner_id
      - status
      - recorded_at
      - source_record_id
