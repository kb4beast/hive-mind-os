{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive-mind-os.invalid/schemas/v1/acceptance-specification.schema.json",
  "title": "Hive Mind OS Executable Acceptance Specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "criterion", "command"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "criterion": {"type": "string", "minLength": 1, "maxLength": 4000},
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "expected"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 16384}},
        "expected": {"enum": ["succeeded", "failed"]}
      }
    },
    "declared_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
