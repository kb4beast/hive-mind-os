{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive-mind-os.invalid/schemas/runtime-contracts-v1.json",
  "title": "Hive Mind OS subject-neutral runtime contracts v1",
  "oneOf": [
    {"$ref": "#/$defs/nodeRuntimeContract"},
    {"$ref": "#/$defs/decisionMemoryEntry"},
    {"$ref": "#/$defs/waveManifest"},
    {"$ref": "#/$defs/hostObservation"},
    {"$ref": "#/$defs/hostLease"},
    {"$ref": "#/$defs/hostExecutionReceipt"},
    {"$ref": "#/$defs/visionPosture"}
  ],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "gitObject": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "time": {"type": "string", "format": "date-time"},
    "stringSet": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["wall_seconds", "model_calls", "input_tokens", "output_tokens", "cost_microunits", "tool_calls", "concurrent_workers"],
      "properties": {
        "wall_seconds": {"type": "integer", "minimum": 0}, "model_calls": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0},
        "cost_microunits": {"type": "integer", "minimum": 0}, "tool_calls": {"type": "integer", "minimum": 0},
        "concurrent_workers": {"type": "integer", "minimum": 0}
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["authority_id", "principal_id", "grant_digest", "allowed_actions", "denied_actions", "expires_at", "external_effects"],
      "properties": {
        "authority_id": {"$ref": "#/$defs/identifier"}, "principal_id": {"$ref": "#/$defs/identifier"},
        "grant_digest": {"$ref": "#/$defs/digest"}, "allowed_actions": {"$ref": "#/$defs/stringSet"},
        "denied_actions": {"$ref": "#/$defs/stringSet"}, "expires_at": {"$ref": "#/$defs/time"},
        "external_effects": {"type": "boolean"}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "digest", "source", "claim_ids", "observed_at"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/identifier"}, "digest": {"$ref": "#/$defs/digest"},
        "source": {"type": "string", "minLength": 1}, "claim_ids": {"$ref": "#/$defs/stringSet", "minItems": 1},
        "observed_at": {"$ref": "#/$defs/time"}
      }
    },
    "nodeRuntimeContract": {
      "type": "object", "additionalProperties": false,
      "required": ["node_id", "dependencies", "durability_role", "durability_providers", "write_scope"],
      "properties": {
        "node_id": {"$ref": "#/$defs/identifier"}, "dependencies": {"$ref": "#/$defs/stringSet"},
        "durability_role": {"enum": ["none", "provider", "consumer"]},
        "durability_providers": {"$ref": "#/$defs/stringSet"}, "write_scope": {"$ref": "#/$defs/stringSet"}
      }
    },
    "decisionAlternative": {
      "type": "object", "additionalProperties": false,
      "required": ["alternative_id", "description", "evidence_ids", "counterevidence_ids", "constraint_results", "authority_ids", "safe"],
      "properties": {
        "alternative_id": {"$ref": "#/$defs/identifier"}, "description": {"type": "string", "minLength": 1},
        "evidence_ids": {"$ref": "#/$defs/stringSet"}, "counterevidence_ids": {"$ref": "#/$defs/stringSet"},
        "constraint_results": {"type": "object", "additionalProperties": {"type": "boolean"}},
        "authority_ids": {"$ref": "#/$defs/stringSet"}, "safe": {"type": "boolean"}
      }
    },
    "score": {
      "type": "object", "additionalProperties": false, "required": ["alternative_id", "score"],
      "properties": {"alternative_id": {"$ref": "#/$defs/identifier"}, "score": {"type": "number"}}
    },
    "decisionMemoryEntry": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "memory_id", "question", "snapshot", "alternatives", "evidence", "counterevidence",
        "constraints", "authority", "budget", "scoring_model", "scores", "winner", "losers", "uncertainty",
        "owner", "decided_at", "fresh_until", "corrections", "supersession", "appeal_state", "entry_digest"
      ],
      "properties": {
        "schema_version": {"const": 1}, "memory_id": {"$ref": "#/$defs/identifier"},
        "question": {"type": "string", "minLength": 1}, "snapshot": {"$ref": "#/$defs/digest"},
        "alternatives": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/decisionAlternative"}},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "counterevidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "constraints": {"$ref": "#/$defs/stringSet", "minItems": 1},
        "authority": {"type": "array", "items": {"$ref": "#/$defs/authority"}},
        "budget": {"$ref": "#/$defs/budget"}, "scoring_model": {"$ref": "#/$defs/identifier"},
        "scores": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/score"}},
        "winner": {"$ref": "#/$defs/identifier"}, "losers": {"$ref": "#/$defs/stringSet"},
        "uncertainty": {"type": "string", "minLength": 1}, "owner": {"$ref": "#/$defs/identifier"},
        "decided_at": {"$ref": "#/$defs/time"}, "fresh_until": {"$ref": "#/$defs/time"},
        "corrections": {"$ref": "#/$defs/stringSet"},
        "supersession": {"oneOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
        "appeal_state": {"enum": ["NONE", "OPEN", "UPHELD", "OVERTURNED", "SUPERSEDED"]},
        "entry_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "waveNode": {
      "type": "object", "additionalProperties": false,
      "required": ["node_id", "state", "attempt", "checkpoint_digest", "result_digest"],
      "properties": {
        "node_id": {"$ref": "#/$defs/identifier"},
        "state": {"enum": ["PENDING", "READY", "RUNNING", "CHECKPOINTED", "COMPLETED", "RECOVERABLE", "REPLAN_REQUIRED", "FAILED", "CANCELLED"]},
        "attempt": {"type": "integer", "minimum": 0},
        "checkpoint_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "result_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}
      }
    },
    "candidateIdentity": {
      "type": "object", "additionalProperties": false, "required": ["commit", "tree", "subject_id"],
      "properties": {"commit": {"$ref": "#/$defs/gitObject"}, "tree": {"$ref": "#/$defs/gitObject"}, "subject_id": {"$ref": "#/$defs/digest"}}
    },
    "waveManifest": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "wave_id", "plan_digest", "generation_id", "subject_id", "parent_wave_digest", "state", "nodes", "checkpoint_digest", "candidate", "created_at", "manifest_digest"],
      "properties": {
        "schema_version": {"const": 1}, "wave_id": {"$ref": "#/$defs/identifier"},
        "plan_digest": {"$ref": "#/$defs/digest"}, "generation_id": {"$ref": "#/$defs/digest"},
        "subject_id": {"$ref": "#/$defs/digest"},
        "parent_wave_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "state": {"enum": ["PLANNED", "RUNNING", "CHECKPOINTED", "CANDIDATE_SEALED", "VERIFYING", "INTEGRATION_READY", "RECOVERABLE", "REPLAN_REQUIRED", "INTEGRATED", "FAILED", "CANCELLED"]},
        "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/waveNode"}},
        "checkpoint_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "candidate": {"oneOf": [{"$ref": "#/$defs/candidateIdentity"}, {"type": "null"}]},
        "created_at": {"$ref": "#/$defs/time"}, "manifest_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "hostIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["host_id", "platform", "architecture", "runtime_version", "executable_digest", "adapter_digest"],
      "properties": {
        "host_id": {"$ref": "#/$defs/identifier"}, "platform": {"$ref": "#/$defs/identifier"},
        "architecture": {"$ref": "#/$defs/identifier"}, "runtime_version": {"$ref": "#/$defs/identifier"},
        "executable_digest": {"$ref": "#/$defs/digest"}, "adapter_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "hostObservation": {
      "type": "object", "additionalProperties": false,
      "required": ["identity", "subject_id", "observed_at", "capabilities", "trust_evidence_digest", "clean"],
      "properties": {
        "identity": {"$ref": "#/$defs/hostIdentity"}, "subject_id": {"$ref": "#/$defs/digest"},
        "observed_at": {"$ref": "#/$defs/time"}, "capabilities": {"$ref": "#/$defs/stringSet"},
        "trust_evidence_digest": {"$ref": "#/$defs/digest"}, "clean": {"type": "boolean"}
      }
    },
    "hostLease": {
      "type": "object", "additionalProperties": false,
      "required": ["lease_id", "host_id", "subject_id", "generation_id", "authority_digest", "adapter_inventory_digest", "external_effects_required", "compilation_digest", "activation_digest", "activation_proof_digest", "candidate_commit", "candidate_tree", "candidate_content_sha256", "candidate_parent_commit", "candidate_parent_tree", "manifest_sha256", "repository_id", "request_sha256", "target_branch", "execution_client_sha256", "activation_issued_at", "protected_merge_authorized", "host_identity_digest", "trust_evidence_digest", "required_capabilities", "issued_at", "expires_at", "allowed_node_ids", "nonce_digest"],
      "properties": {
        "lease_id": {"$ref": "#/$defs/identifier"}, "host_id": {"$ref": "#/$defs/identifier"},
        "subject_id": {"$ref": "#/$defs/digest"}, "generation_id": {"$ref": "#/$defs/digest"},
        "authority_digest": {"$ref": "#/$defs/digest"},
        "adapter_inventory_digest": {"$ref": "#/$defs/digest"},
        "external_effects_required": {"type": "boolean"}, "issued_at": {"$ref": "#/$defs/time"},
        "compilation_digest": {"$ref": "#/$defs/digest"},
        "activation_digest": {"$ref": "#/$defs/digest"}, "activation_proof_digest": {"$ref": "#/$defs/digest"},
        "candidate_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "candidate_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "candidate_content_sha256": {"$ref": "#/$defs/digest"},
        "candidate_parent_commit": {"$ref": "#/$defs/gitObject"},
        "candidate_parent_tree": {"$ref": "#/$defs/gitObject"},
        "manifest_sha256": {"$ref": "#/$defs/digest"},
        "repository_id": {"$ref": "#/$defs/digest"},
        "request_sha256": {"$ref": "#/$defs/digest"},
        "target_branch": {"$ref": "#/$defs/identifier"},
        "execution_client_sha256": {"$ref": "#/$defs/digest"},
        "activation_issued_at": {"$ref": "#/$defs/time"},
        "protected_merge_authorized": {"const": false},
        "host_identity_digest": {"$ref": "#/$defs/digest"},
        "trust_evidence_digest": {"$ref": "#/$defs/digest"},
        "required_capabilities": {"$ref": "#/$defs/stringSet", "contains": {"const": "host-enforced-deadline-v1"}},
        "expires_at": {"$ref": "#/$defs/time"}, "allowed_node_ids": {"$ref": "#/$defs/stringSet", "minItems": 1},
        "nonce_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "hostExecutionReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["receipt_id", "lease_id", "node_id", "state", "input_digest", "output_digest", "evidence_digest", "observed_at"],
      "properties": {
        "receipt_id": {"$ref": "#/$defs/identifier"}, "lease_id": {"$ref": "#/$defs/identifier"},
        "node_id": {"$ref": "#/$defs/identifier"}, "state": {"enum": ["SUCCEEDED", "FAILED", "CANCELLED", "DENIED"]},
        "input_digest": {"$ref": "#/$defs/digest"},
        "output_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "evidence_digest": {"$ref": "#/$defs/digest"}, "observed_at": {"$ref": "#/$defs/time"}
      }
    },
    "visionPosture": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "a5", "active_gate_reference_only_conflict", "forbidden_claims", "maximum_claim"],
      "properties": {
        "schema_version": {"const": 1}, "a5": {"enum": ["READY", "NOT_READY"]},
        "active_gate_reference_only_conflict": {"enum": ["RESOLVED", "UNRESOLVED"]},
        "forbidden_claims": {"$ref": "#/$defs/stringSet"}, "maximum_claim": {"$ref": "#/$defs/identifier"}
      }
    }
  }
}
