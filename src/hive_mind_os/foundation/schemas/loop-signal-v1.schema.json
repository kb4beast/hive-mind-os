{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive-mind-os.invalid/contracts/loop-signal/v1",
  "type": "object",
  "required": ["record_type", "schema_version", "signal_id", "subject_id", "progress_fingerprint", "signal", "severity", "evidence_refs", "enforcement"],
  "properties": {
    "record_type": {"const": "loop-signal"},
    "schema_version": {"const": 1},
    "signal_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "progress_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "signal": {"type": "string", "enum": ["progress", "repeat", "stall", "oscillation", "unknown"]},
    "severity": {"type": "string", "enum": ["info", "warning", "critical"]},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "enforcement": {"const": "none-phase2"}
  },
  "additionalProperties": false
}
