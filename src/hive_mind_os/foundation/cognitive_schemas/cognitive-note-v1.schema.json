{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive-mind-os.invalid/contracts/cognitive-note/v1",
  "type": "object",
  "required": ["schema_version", "note_id", "note_kind", "subject_id", "source_record_id", "memory_kind", "tenant_id", "repository_id", "repository_identity_digest", "mission_id", "run_id", "step_id", "actor_id", "owner_id", "observed_at", "recorded_at", "status", "confidence_ppm", "freshness_expires_at", "sensitivity", "source_schema", "source_digest", "source_previous_digest", "previous_record_id", "supersedes_record_id", "source_refs", "claim_refs", "evidence_refs", "court_refs", "code_receipt_refs", "generation_refs", "contradiction_refs", "relation_refs", "public_release_decision_id", "public_release_decided_by", "projection_cursor", "content_digest", "generator_version", "mapping_version", "is_generated", "is_authoritative"],
  "properties": {
    "schema_version": {"const": "hive-cognitive-note/v1"},
    "note_id": {"type": "string", "pattern": "^cognitive-note:[0-9a-f]{64}$"},
    "note_kind": {"type": "string", "enum": ["idea", "evidence", "court", "run", "agent", "telemetry"]},
    "subject_id": {"type": "string", "minLength": 1, "maxLength": 4096},
    "source_record_id": {"type": "string", "minLength": 1, "maxLength": 4096},
    "memory_kind": {"type": "string", "enum": ["working", "episodic", "semantic", "procedural", "prospective", "decision", "opportunity", "counterfactual", "social", "evaluation", "resource", "governance", "not-applicable"]},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 4096},
    "repository_id": {"type": "string", "minLength": 1, "maxLength": 4096},
    "repository_identity_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "mission_id": {"type": ["string", "null"], "maxLength": 4096},
    "run_id": {"type": ["string", "null"], "maxLength": 4096},
    "step_id": {"type": ["string", "null"], "maxLength": 4096},
    "actor_id": {"type": "string", "minLength": 1, "maxLength": 4096},
    "owner_id": {"type": ["string", "null"], "maxLength": 4096},
    "observed_at": {"type": "string", "minLength": 1, "maxLength": 4096},
    "recorded_at": {"type": "string", "minLength": 1, "maxLength": 4096},
    "status": {"type": "string", "minLength": 1, "maxLength": 4096},
    "confidence_ppm": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000},
    "freshness_expires_at": {"type": ["string", "null"], "maxLength": 4096},
    "sensitivity": {"const": "safe-public"},
    "source_schema": {"const": "memory-record-v1"},
    "source_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_previous_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "previous_record_id": {"type": ["string", "null"], "maxLength": 4096},
    "supersedes_record_id": {"type": ["string", "null"], "maxLength": 4096},
    "source_refs": {"type": "array", "maxItems": 256, "items": {"type": "string", "maxLength": 4096}},
    "claim_refs": {"type": "array", "maxItems": 256, "items": {"type": "string", "maxLength": 4096}},
    "evidence_refs": {"type": "array", "maxItems": 256, "items": {"type": "string", "maxLength": 4096}},
    "court_refs": {"type": "array", "maxItems": 256, "items": {"type": "string", "maxLength": 4096}},
    "code_receipt_refs": {"type": "array", "maxItems": 256, "items": {"type": "string", "maxLength": 4096}},
    "generation_refs": {"type": "array", "maxItems": 256, "items": {"type": "string", "maxLength": 4096}},
    "contradiction_refs": {"type": "array", "maxItems": 256, "items": {"type": "string", "maxLength": 4096}},
    "relation_refs": {"type": "array", "maxItems": 256, "items": {"type": "string", "maxLength": 4096}},
    "public_release_decision_id": {"type": "string", "minLength": 1, "maxLength": 4096},
    "public_release_decided_by": {"type": "string", "minLength": 1, "maxLength": 4096},
    "projection_cursor": {"type": "string", "pattern": "^memory-set:[0-9a-f]{64}$"},
    "content_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "generator_version": {"const": "hive-cognitive-projector/v1"},
    "mapping_version": {"const": "hive-cognitive-mapping/v1"},
    "is_generated": {"const": true},
    "is_authoritative": {"const": false}
  },
  "additionalProperties": false
}
