{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive-mind-os.invalid/schemas/v1/custody-keyset.schema.json",
  "title": "Hive Mind OS External Custody Keyset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authority_id", "sequence", "issued_at", "expires_at", "issuer_key_id", "issuer_identity", "keys", "signature"],
  "properties": {
    "schema_version": {"const": 1},
    "authority_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "issuer_key_id": {"type": "string", "minLength": 1},
    "issuer_identity": {"type": "string", "minLength": 1},
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_id", "signer_identity", "public_key", "status", "not_before", "not_after", "revoked_at"],
        "properties": {
          "key_id": {"type": "string", "minLength": 1},
          "signer_identity": {"type": "string", "minLength": 1},
          "public_key": {"type": "string", "minLength": 43, "maxLength": 43, "pattern": "^[A-Za-z0-9_-]+$"},
          "status": {"enum": ["active", "revoked"]},
          "not_before": {"type": "string", "format": "date-time"},
          "not_after": {"type": ["string", "null"], "format": "date-time"},
          "revoked_at": {"type": ["string", "null"], "format": "date-time"}
        },
        "allOf": [
          {"if": {"properties": {"status": {"const": "revoked"}}}, "then": {"properties": {"revoked_at": {"type": "string", "format": "date-time"}}}},
          {"if": {"properties": {"status": {"const": "active"}}}, "then": {"properties": {"revoked_at": {"type": "null"}}}}
        ]
      }
    },
    "signature": {"type": "string", "minLength": 86, "maxLength": 86, "pattern": "^[A-Za-z0-9_-]+$"}
  }
}
