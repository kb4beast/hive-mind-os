		{"height":180,"id":"8aba3a0d2bddebb95fd9fab93665fcbdcd8ccbbfb88e0a133c2a680dd58079ee","text":"# Released cognitive views\n\nStatic, safe-public, generated, nonauthoritative metadata. This is not live operational state.","type":"text","width":720,"x":0,"y":0},
		{"height":160,"id":"eb1a8e0fa14dc2b18f8721748bbad6a20ecd8da6710ad851bbc4bd9dfa05e6f5","text":"Agent scores and health are unavailable. Released agent-related records are not scorecards.","type":"text","width":340,"x":0,"y":220},
		{"height":160,"id":"4aac881b8e90da93c2a8e53e3fdd6c8f90ca53bea7af07c4be41875313891dce","text":"Token and value accounting are unavailable. Unknown does not imply zero.","type":"text","width":340,"x":380,"y":220},
		{"height":160,"id":"ccc00e81f111e3bab70f7de22affcde4a4b6598c7fdd41636a3054b0b4520607","text":"Loop state is unavailable because the released cognitive source exposes no loop signal.","type":"text","width":340,"x":0,"y":420},
