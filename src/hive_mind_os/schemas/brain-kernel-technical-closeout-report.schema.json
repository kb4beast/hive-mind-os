{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive-mind-os.local/schemas/brain-kernel-technical-closeout-report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["mission_id", "event_head_digest", "projection_digest", "required_roles", "fulfilled_roles", "missing_obligations", "integrated_work_ids", "evaluation_result_digests", "evidence_bundle_digests", "state", "report_digest"],
  "properties": {
    "mission_id": {"type": "string", "pattern": "^MISSION-"},
    "event_head_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "projection_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "required_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["orchestrator", "explorer", "architect", "builder", "curator", "integrator", "steward", "optimizer"]}},
    "fulfilled_roles": {"type": "array", "uniqueItems": true, "items": {"enum": ["orchestrator", "explorer", "architect", "builder", "curator", "integrator", "steward", "optimizer"]}},
    "missing_obligations": {"type": "array", "items": {"type": "string"}},
    "integrated_work_ids": {"type": "array", "items": {"type": "string", "pattern": "^WORK-"}},
    "evaluation_result_digests": {"type": "array", "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "evidence_bundle_digests": {"type": "array", "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "state": {"enum": ["TECHNICALLY_VERIFIED", "PARTIAL", "BLOCKED"]},
    "report_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
