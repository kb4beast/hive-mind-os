{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive-mind-os.invalid/schemas/v1/tool-receipt.schema.json",
  "title": "Hive Mind OS Tool Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "action_id", "provider", "execution_id", "mission_id", "state_ref", "actor_id", "policy_decision_ref", "lease_id", "action_kind", "action_digest", "executed", "result", "observed_at", "artifacts", "verified_by"],
  "properties": {
    "schema_version": {"const": 1},
    "receipt_id": {"type": "string", "minLength": 1},
    "action_id": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "execution_id": {"type": "string", "minLength": 1},
    "mission_id": {"type": "string", "minLength": 1},
    "state_ref": {"type": "string", "minLength": 1},
    "actor_id": {"type": "string", "minLength": 1},
    "policy_decision_ref": {"type": "string", "minLength": 1},
    "lease_id": {"type": "string", "minLength": 1},
    "action_kind": {"enum": ["reasoning", "read", "write", "command", "network", "git", "message", "deploy"]},
    "action_digest": {"type": "string", "maxLength": 71, "pattern": "^sha256:[0-9a-f]{64}$"},
    "executed": {"const": true},
    "result": {"enum": ["succeeded", "failed", "unknown"]},
    "observed_at": {"type": "string", "format": "date-time"},
    "artifacts": {"type": "array", "items": {"$ref": "artifact-manifest.schema.json"}},
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "exit_code", "duration_ms", "outcome", "stdout", "stderr", "sandbox_spec_digest", "runner_identity"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "exit_code": {"type": ["integer", "null"]},
        "duration_ms": {"type": "number", "minimum": 0},
        "outcome": {"enum": ["succeeded", "failed", "timeout"]},
        "stdout": {
          "type": "object",
          "additionalProperties": false,
          "required": ["digest", "bytes", "truncated"],
          "properties": {
            "digest": {"type": "string", "maxLength": 71, "pattern": "^sha256:[0-9a-f]{64}$"},
            "bytes": {"type": "integer", "minimum": 0},
            "truncated": {"type": "boolean"}
          }
        },
        "stderr": {
          "type": "object",
          "additionalProperties": false,
          "required": ["digest", "bytes", "truncated"],
          "properties": {
            "digest": {"type": "string", "maxLength": 71, "pattern": "^sha256:[0-9a-f]{64}$"},
            "bytes": {"type": "integer", "minimum": 0},
            "truncated": {"type": "boolean"}
          }
        },
        "sandbox_spec_digest": {"type": "string", "maxLength": 71, "pattern": "^sha256:[0-9a-f]{64}$"},
        "runner_identity": {"type": "string", "minLength": 1}
      }
    },
    "verified_by": {"type": "string", "minLength": 1}
  }
}
